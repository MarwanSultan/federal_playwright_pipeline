# Approved non-production target only. Never commit .env files or credentials.
BASE_URL=https://replace-with-approved-test-target.example.gov
API_BASE_URL=https://replace-with-approved-api-target.example.gov
ENVIRONMENT_CLASSIFICATION=non-production
ENABLE_CROSS_BROWSER=false

# Secret values must be supplied by an approved local secret store or CI environment.
# TEST_USERNAME=
# TEST_PASSWORD=
# MFA_TEST_SECRET=

# Enable only in an approved non-production environment with synthetic data.
CRITICAL_WORKFLOWS_READY=false
# Each path is application-specific and must be supplied by the application owner.
# CRITICAL_AUTH_PATH=/replace-with-approved-auth-path
# CRITICAL_AUTH_MARKER=synthetic-authenticated-user
# CRITICAL_PRIMARY_PATH=/replace-with-approved-primary-workflow-path
# CRITICAL_PRIMARY_MARKER=synthetic-primary-workflow-complete
# CRITICAL_SUBMISSION_PATH=/replace-with-approved-submission-path
# CRITICAL_SUBMISSION_MARKER=synthetic-submission-confirmed
# CRITICAL_AUTHZ_PATH=/replace-with-approved-authorization-path
# CRITICAL_AUTHZ_MARKER=synthetic-authorized-view
# CRITICAL_AUDIT_PATH=/replace-with-approved-audit-path
# CRITICAL_AUDIT_MARKER=synthetic-audit-confirmed

# ============================================================================
# API Tests Configuration (tests/api/critical-api.spec.ts)
# ============================================================================
# Set API_TESTS_READY=true to enable API contract-driven tests (7 tests).
# Each API path and marker must be supplied by the API contract.
API_TESTS_READY=false
# API_HEALTH_PATH=/api/health
# API_AUTH_PATH=/api/auth
# API_AUTH_STATUS=200
# API_PRIMARY_PATH=/api/primary
# API_PRIMARY_MARKER=primary-success
# API_SUBMISSION_PATH=/api/submit
# API_SUBMISSION_MARKER=submission-confirmed
# API_SUBMISSION_BODY={"action":"test"}
# API_UNAUTHORIZED_PATH=/api/protected
# API_UNAUTHORIZED_STATUS=403
# API_AUDIT_PATH=/api/audit
# API_AUDIT_MARKER=audit-entry

# ============================================================================
# Security API Regression Tests Configuration (tests/api/security-regression.spec.ts)
# ============================================================================
# Requires API_TESTS_READY=true plus security-specific endpoint configuration (6 tests).
# API_SECURITY_PATH=/api/security
# API_REQUIRED_HEADERS={"content-security-policy":"default-src 'self'","x-frame-options":"DENY"}
# API_PROTECTED_PATH=/api/protected
# API_PROTECTED_STATUS=401
# API_FORBIDDEN_PATH=/api/forbidden
# API_FORBIDDEN_TOKEN=test-token
# API_FORBIDDEN_STATUS=403
# API_VALIDATION_PATH=/api/validate
# API_VALIDATION_BODY={"invalid":"payload"}
# API_VALIDATION_STATUS=400
# API_METHOD_PATH=/api/method
# API_UNSUPPORTED_METHOD=TRACE
# API_METHOD_STATUS=405
# API_AUDIT_PATH=/api/audit
# API_AUDIT_REQUIRED_FIELDS=timestamp,event_type,user_id

# ============================================================================
# Authorization Tests Configuration (tests/security/authorization.spec.ts)
# ============================================================================
# Set AUTHZ_CONTRACT_READY=true to enable authorization tests (1 test).
# Requires approved role/resource fixtures and endpoint contract.
AUTHZ_CONTRACT_READY=false
