{
  "name": "playwright_pipeline",
  "version": "1.0.0",
  "description": "Auditable, security-focused Playwright automation platform",
  "scripts": {
    "format:check": "prettier --check \"**/*.{ts,mjs,json,yml,yaml}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "traceability:validate": "node scripts/validate-traceability.cjs",
    "test": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:security": "playwright test tests/security",
    "test:critical": "playwright test tests/critical",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install chromium",
    "docker:build": "docker compose build framework",
    "docker:validate": "docker compose run --rm validate",
    "docker:test": "docker compose run --rm framework",
    "docker:security": "docker compose run --rm security-tests",
    "docker:pipeline": "npm run docker:build && npm run docker:validate && npm run docker:test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
